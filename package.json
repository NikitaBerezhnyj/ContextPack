{
  "name": "context-pack",
  "displayName": "ContextPack",
  "description": "Copy and combine the contents of selected files and folders into a single text output.",
  "version": "1.0.0",
  "publisher": "NikitaBerezhnyj",
  "icon": "assets/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NikitaBerezhnyj/ContextPack"
  },
  "bugs": {
    "url": "https://github.com/NikitaBerezhnyj/ContextPack/issues"
  },
  "keywords": [
    "copy",
    "clipboard",
    "files",
    "folders",
    "context",
    "ai",
    "llm",
    "prompt",
    "explorer"
  ],
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "copyFileContents.copy",
        "title": "Copy Contents of Files"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "copyFileContents.copy",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "copyFileContents.copy",
          "group": "6_copypath"
        }
      ]
    },
    "configuration": {
      "title": "ContextPack",
      "properties": {
        "copyFileContents.ignoredFolders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "node_modules",
            ".git",
            "dist",
            "out",
            "build",
            "target",
            "bin",
            "obj",
            "venv",
            ".venv",
            "__pycache__",
            ".next",
            ".dart_tool",
            ".gradle",
            ".idea",
            "Pods"
          ],
          "description": "Folder names skipped when copying the contents of a selected folder."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier src --write",
    "prepare:readme": "shx cp README.md README.md.bak && shx cp assets/README.md README.md",
    "restore:readme": "shx mv README.md.bak README.md",
    "build:vsix": "vsce package",
    "vsix": "run-s --continue-on-error prepare:readme build:vsix restore:readme"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "@types/vscode": "^1.140.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.10",
    "shx": "^0.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  }
}
