// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "npm: watch:esbuild",
            "type": "npm",
            "script": "watch:esbuild",
            "isBackground": true,
            "problemMatcher": {
                "pattern": [
                    {
                        "regexp": "^✘ \\[ERROR\\] (.*)$",
                        "message": 1
                    },
                    {
                        "regexp": "^\\s+(.*):(\\d+):(\\d+):$",
                        "file": 1,
                        "line": 2,
                        "column": 3
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "\\[watch\\] build started",
                    "endsPattern": "\\[watch\\] build finished"
                }
            },
            "presentation": {
                "group": "watch",
                "reveal": "never"
            }
        },
        {
            "label": "npm: watch:tsc",
            "type": "npm",
            "script": "watch:tsc",
            "isBackground": true,
            "problemMatcher": "$tsc-watch",
            "presentation": {
                "group": "watch",
                "reveal": "never"
            }
        },
        {
            "label": "watch",
            "dependsOn": [
                "npm: watch:tsc",
                "npm: watch:esbuild"
            ],
            "dependsOrder": "parallel",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}